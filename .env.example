# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Reminder engine
# Shared secret the database schedule sends to /api/cron/reminders.
# Store the same value in Supabase Vault as 'cron_secret' (see the reminder_engine migration).
CRON_SECRET=
# Public address of the app, used for links in reminder emails.
APP_URL=

# Email (Resend)
RESEND_API_KEY=
# Sender, e.g. "Kalends <reminders@yourdomain.com>". Defaults to Resend's test sender.
EMAIL_FROM=

# AI document scanning (Phase 2)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash.
GEMINI_MODEL=

# Local development only (.env.development.local):
# local Supabase URL and keys from `npx supabase start`, and
# MAILPIT_URL=http://127.0.0.1:54324 to catch emails in the local inbox.
